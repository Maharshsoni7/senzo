{
  "openapi": "3.1.0",
  "info": {
    "title": "Senzo API",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "OtpRequestResult": {
        "type": "object",
        "properties": {
          "retryAfterSec": {
            "type": "integer"
          }
        },
        "required": [
          "retryAfterSec"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "RATE_LIMITED",
              "IDEMPOTENCY_KEY_REQUIRED",
              "IDEMPOTENCY_KEY_REUSED",
              "IDEMPOTENCY_IN_PROGRESS",
              "INTERNAL",
              "SLOT_TAKEN",
              "BELOW_CHEF_MINIMUM",
              "OTP_INVALID",
              "OTP_LOCKED",
              "OUTSIDE_SERVICE_AREA",
              "POLICY_WINDOW_CLOSED",
              "TURNSTILE_FAILED",
              "SESSION_REVOKED"
            ]
          },
          "detail": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "retryAfterSec": {
            "type": "integer"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "OtpRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "turnstileToken": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "type": "string",
            "enum": [
              "sms",
              "voice"
            ],
            "default": "sms"
          }
        },
        "required": [
          "phone",
          "turnstileToken"
        ]
      },
      "AuthResult": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "isNewUser": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "guest",
                "chef"
              ]
            }
          }
        },
        "required": [
          "accessToken",
          "accessExpiresAt",
          "refreshToken",
          "refreshExpiresAt",
          "isNewUser",
          "roles"
        ]
      },
      "OtpVerify": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "device": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string",
                "enum": [
                  "android",
                  "ios",
                  "web"
                ]
              },
              "app": {
                "type": "string",
                "enum": [
                  "guest",
                  "partner"
                ]
              },
              "pushToken": {
                "type": "string"
              }
            },
            "required": [
              "platform",
              "app"
            ]
          }
        },
        "required": [
          "phone",
          "code",
          "device"
        ]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "accessToken",
          "accessExpiresAt",
          "refreshToken",
          "refreshExpiresAt"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/otp/request": {
      "post": {
        "operationId": "requestOtp",
        "tags": [
          "auth"
        ],
        "summary": "Send a login code by SMS or voice call",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Code sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpRequestResult"
                }
              }
            }
          },
          "403": {
            "description": "Turnstile check failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many codes for this number",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/otp/verify": {
      "post": {
        "operationId": "verifyOtp",
        "tags": [
          "auth"
        ],
        "summary": "Check the code and start a session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerify"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResult"
                }
              }
            }
          },
          "422": {
            "description": "Wrong or expired code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "423": {
            "description": "Too many wrong tries",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "tags": [
          "auth"
        ],
        "summary": "Swap a refresh token for a new pair; the old one stops working",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "401": {
            "description": "Unknown, expired or reused refresh token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
