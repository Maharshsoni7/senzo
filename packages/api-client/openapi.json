    "/v1/chefs/{chefId}/availability": {
      "get": {
        "operationId": "getChefAvailability",
        "tags": [
          "discovery"
        ],
        "summary": "Open, booked and off slots for one month (G08)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "chefId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "required": true,
            "name": "month",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "One entry per day",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChefMonthAvailability"
                }
              }
            }
          },
          "404": {
            "description": "Chef not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chefs": {
      "get": {
        "operationId": "listChefs",
        "tags": [
          "discovery"
        ],
        "summary": "Home rail and search (G04, G05): live chefs, ranked",
        "parameters": [
          {
            "schema": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -90,
              "maximum": 90
            },
            "required": false,
            "name": "lat",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -180,
              "maximum": 180
            },
            "required": false,
            "name": "lng",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 60
            },
            "required": false,
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "jain",
                "no_onion_garlic"
              ]
            },
            "required": false,
            "name": "rule",
            "in": "query"
          },
          {
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "required": false,
            "name": "cuisine",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "required": false,
            "name": "guests",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date"
            },
            "required": false,
            "name": "date",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "lunch",
                "dinner",
                "late"
              ]
            },
            "required": false,
            "name": "slot",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked chef cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChefList"
                }
              }
            }
          }
        }
      }
    },
