{
  "openapi": "3.1.0",
  "info": {
    "title": "Senzo API",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "OtpRequestResult": {
        "type": "object",
        "properties": {
          "retryAfterSec": {
            "type": "integer"
          }
        },
        "required": [
          "retryAfterSec"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "RATE_LIMITED",
              "IDEMPOTENCY_KEY_REQUIRED",
              "IDEMPOTENCY_KEY_REUSED",
              "IDEMPOTENCY_IN_PROGRESS",
              "INTERNAL",
              "SLOT_TAKEN",
              "BELOW_CHEF_MINIMUM",
              "OTP_INVALID",
              "OTP_LOCKED",
              "OUTSIDE_SERVICE_AREA",
              "POLICY_WINDOW_CLOSED",
              "TURNSTILE_FAILED",
              "SESSION_REVOKED",
              "FOOD_RULE_UNAVAILABLE",
              "GUESTS_OUT_OF_RANGE",
              "PROMO_INVALID",
              "INVALID_TRANSITION",
              "STATE_CONFLICT",
              "SLOT_UNAVAILABLE"
            ]
          },
          "detail": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "retryAfterSec": {
            "type": "integer"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "OtpRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "turnstileToken": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "type": "string",
            "enum": [
              "sms",
              "voice"
            ],
            "default": "sms"
          }
        },
        "required": [
          "phone",
          "turnstileToken"
        ]
      },
      "AuthResult": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "isNewUser": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "guest",
                "chef"
              ]
            }
          }
        },
        "required": [
          "accessToken",
          "accessExpiresAt",
          "refreshToken",
          "refreshExpiresAt",
          "isNewUser",
          "roles"
        ]
      },
      "OtpVerify": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "device": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string",
                "enum": [
                  "android",
                  "ios",
                  "web"
                ]
              },
              "app": {
                "type": "string",
                "enum": [
                  "guest",
                  "partner"
                ]
              },
              "pushToken": {
                "type": "string"
              }
            },
            "required": [
              "platform",
              "app"
            ]
          }
        },
        "required": [
          "phone",
          "code",
          "device"
        ]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "accessToken",
          "accessExpiresAt",
          "refreshToken",
          "refreshExpiresAt"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "Quote": {
        "type": "object",
        "properties": {
          "menuId": {
            "type": "string"
          },
          "chefId": {
            "type": "string"
          },
          "guests": {
            "type": "integer"
          },
          "foodRule": {
            "type": "string",
            "enum": [
              "regular",
              "jain",
              "no_onion_garlic"
            ]
          },
          "groceriesBy": {
            "type": "string",
            "enum": [
              "chef",
              "guest"
            ]
          },
          "band": {
            "type": "object",
            "properties": {
              "minGuests": {
                "type": "integer"
              },
              "maxGuests": {
                "type": "integer"
              },
              "pricePerGuestPaise": {
                "type": "integer"
              }
            },
            "required": [
              "minGuests",
              "maxGuests",
              "pricePerGuestPaise"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "course": {
                  "type": "string"
                },
                "optionId": {
                  "type": "string"
                },
                "dishName": {
                  "type": "string"
                },
                "extraPaise": {
                  "type": "integer"
                },
                "jainVersion": {
                  "type": "boolean"
                },
                "servedAs": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "swappedFrom": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "course",
                "optionId",
                "dishName",
                "extraPaise",
                "jainVersion",
                "servedAs",
                "swappedFrom"
              ]
            }
          },
          "addons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "pricePerGuestPaise": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "name",
                "pricePerGuestPaise"
              ]
            }
          },
          "perGuestPaise": {
            "type": "integer"
          },
          "groceriesSavingPerGuestPaise": {
            "type": "integer"
          },
          "oneOffs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "induction"
                  ]
                },
                "amountPaise": {
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "amountPaise"
              ]
            }
          },
          "menuTotalPaise": {
            "type": "integer"
          },
          "minimumPaise": {
            "type": "integer"
          },
          "bookable": {
            "type": "boolean"
          },
          "convenienceFeePaise": {
            "type": "integer"
          },
          "convenienceFeeGstPaise": {
            "type": "integer"
          },
          "promo": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "discountPaise": {
                "type": "integer"
              }
            },
            "required": [
              "code",
              "discountPaise"
            ]
          },
          "totalPaise": {
            "type": "integer"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "JAIN_SWAPPED",
                    "NO_OVEN_ALTERNATIVE",
                    "INDUCTION_ADDED",
                    "BELOW_CHEF_MINIMUM"
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ]
            }
          }
        },
        "required": [
          "menuId",
          "chefId",
          "guests",
          "foodRule",
          "groceriesBy",
          "band",
          "items",
          "addons",
          "perGuestPaise",
          "groceriesSavingPerGuestPaise",
          "oneOffs",
          "menuTotalPaise",
          "minimumPaise",
          "bookable",
          "convenienceFeePaise",
          "convenienceFeeGstPaise",
          "promo",
          "totalPaise",
          "warnings"
        ]
      },
      "QuoteRequest": {
        "type": "object",
        "properties": {
          "menuId": {
            "type": "string",
            "minLength": 1
          },
          "guests": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "foodRule": {
            "type": "string",
            "enum": [
              "regular",
              "jain",
              "no_onion_garlic"
            ],
            "default": "regular"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "default": []
          },
          "addons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "default": []
          },
          "groceriesBy": {
            "type": "string",
            "enum": [
              "chef",
              "guest"
            ],
            "default": "chef"
          },
          "kitchen": {
            "type": "object",
            "properties": {
              "gas": {
                "type": "boolean",
                "default": true
              },
              "oven": {
                "type": "boolean",
                "default": true
              },
              "mixer": {
                "type": "boolean",
                "default": true
              },
              "fridge": {
                "type": "boolean",
                "default": true
              }
            },
            "default": {
              "gas": true,
              "oven": true,
              "mixer": true,
              "fridge": true
            }
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "slot": {
            "type": "string",
            "enum": [
              "lunch",
              "dinner",
              "late"
            ]
          },
          "promo": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "menuId",
          "guests"
        ]
      },
      "ChefMonthAvailability": {
        "type": "object",
        "properties": {
          "chefId": {
            "type": "string"
          },
          "month": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "open": {
                  "type": "boolean"
                },
                "slots": {
                  "type": "object",
                  "properties": {
                    "lunch": {
                      "type": "string",
                      "enum": [
                        "open",
                        "booked",
                        "off"
                      ]
                    },
                    "dinner": {
                      "type": "string",
                      "enum": [
                        "open",
                        "booked",
                        "off"
                      ]
                    },
                    "late": {
                      "type": "string",
                      "enum": [
                        "open",
                        "booked",
                        "off"
                      ]
                    }
                  },
                  "required": [
                    "lunch",
                    "dinner",
                    "late"
                  ]
                }
              },
              "required": [
                "date",
                "open",
                "slots"
              ]
            }
          }
        },
        "required": [
          "chefId",
          "month",
          "days"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/otp/request": {
      "post": {
        "operationId": "requestOtp",
        "tags": [
          "auth"
        ],
        "summary": "Send a login code by SMS or voice call",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Code sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpRequestResult"
                }
              }
            }
          },
          "403": {
            "description": "Turnstile check failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many codes for this number",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/otp/verify": {
      "post": {
        "operationId": "verifyOtp",
        "tags": [
          "auth"
        ],
        "summary": "Check the code and start a session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerify"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResult"
                }
              }
            }
          },
          "422": {
            "description": "Wrong or expired code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "423": {
            "description": "Too many wrong tries",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "tags": [
          "auth"
        ],
        "summary": "Swap a refresh token for a new pair; the old one stops working",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "401": {
            "description": "Unknown, expired or reused refresh token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/quotes": {
      "post": {
        "operationId": "createQuote",
        "tags": [
          "menus"
        ],
        "summary": "Price a menu choice on the server (G22, G08, G09)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Price breakdown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "404": {
            "description": "Menu not found or not live",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Guests out of range, food rule not offered or promo invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chefs/{chefId}/availability": {
      "get": {
        "operationId": "getChefAvailability",
        "tags": [
          "discovery"
        ],
        "summary": "Open, booked and off slots for one month (G08)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "chefId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "required": true,
            "name": "month",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "One entry per day",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChefMonthAvailability"
                }
              }
            }
          },
          "404": {
            "description": "Chef not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
