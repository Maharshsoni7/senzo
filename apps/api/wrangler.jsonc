{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senzo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "development" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "senzo-dev",
      // Replace with the real id from `wrangler d1 create senzo-dev` once Cloudflare is connected.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "SLOT_LOCK", "class_name": "SlotLock" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SlotLock"] }],
  "workflows": [
    { "name": "senzo-booking-timers", "binding": "BOOKING_TIMERS", "class_name": "BookingTimers" },
  ],
}
